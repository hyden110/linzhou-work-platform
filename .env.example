# 复制为 .env.local 后填入真实值；.env.local 已被 git 忽略，绝不入库。
# 本机启动 npm run dev:function 时会自动读取 .env.local（--env-file-if-exists）；
# 该文件不存在时，直接从当前终端继承同名环境变量。

# 百炼（DashScope）密钥：用于 AI 问答与语义检索。
# 缺失时本地 Function 会静默降级为仅关键词召回（AI 未启用），不会报错。
DASHSCOPE_API_KEY=

# AI 问答使用的百炼模型名；留空时默认 qwen-plus。
DASHSCOPE_ANSWER_MODEL=

# 可选：Qoder Cloud Agents 通道（四者齐备时才启用，否则回退到百炼通道）。
QODER_PAT=
QODER_AGENT_ID=
QODER_AGENT_VERSION=
QODER_ENVIRONMENT_ID=

# 可选：额外允许访问本地 Function 的前端来源，逗号分隔。
# 留空时默认允许 http://127.0.0.1:4173 与 http://localhost:4173。
SA_WORKBENCH_ALLOWED_ORIGINS=

# 运营推广视图「千仔讯息」源的定位值：千仔运营助手单聊的 openDingTalkId。
# 只从环境变量读取，不硬编码在代码里；缺失时该源显示「未同步」，其余三源不受影响。
# 可用 dws chat +bot-find --query "千仔" 在本机重新定位并覆盖此值。
OPS_QIANZAI_OPEN_DINGTALK_ID=DsC0WRjnWscKriP4A6zJHqpmKhiPiSNIfMty
